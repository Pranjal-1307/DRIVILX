# Geocoding provider must implement the Nominatim search/reverse API.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
DRIVILX_CONTACT_EMAIL=replace-with-a-monitored-contact@example.com
PHOTON_BASE_URL=https://photon.komoot.io

# Router must implement OSRM's /route/v1/{profile}/{coordinates} API.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_ROUTE_PROFILE=driving
